// CarCare — Prisma schema
// Grown incrementally, one migration per delivery phase.
// Full target ERD: ../../docs/database.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 — identity foundation
// ---------------------------------------------------------------------------

/// Coarse-grained platform role. Vehicle-level permissions are separate
/// (see VehicleMember, Phase 3) — this only distinguishes staff from users.
enum UserRole {
  USER
  ADMIN
}

model User {
  id    String @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed; uniqueness is enforced here so
  /// two casings of the same address cannot both register.
  email String @unique @db.VarChar(320)

  /// Null for an account that has only ever signed in through a provider.
  /// Nullable rather than a sentinel value: a column that sometimes holds "no
  /// password" as a string is a column someone eventually compares against.
  passwordHash String?  @db.VarChar(255)
  displayName  String   @db.VarChar(120)
  role         UserRole @default(USER)

  /// Display preferences. ISO-4217 code; TND is a 3-decimal currency, which is
  /// why every monetary column is numeric(_, 3) rather than numeric(_, 2).
  currency String @default("TND") @db.Char(3)
  locale   String @default("en") @db.VarChar(10)
  timezone String @default("Africa/Tunis") @db.VarChar(64)

  /// Whether due reminders are also emailed. The in-app inbox always gets them.
  emailNotifications Boolean @default(true)

  /// When the person proved they read this address, by a link sent to it — or
  /// at sign-up through a provider that had already checked it. Nothing is
  /// emailed to an address until then: anyone can type someone else's.
  emailVerifiedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  refreshTokens   RefreshToken[]
  oauthAccounts   OAuthAccount[]
  vehicles        Vehicle[]
  vehicleMembers  VehicleMember[]
  expenses        Expense[]
  idempotencyKeys IdempotencyKey[]
  documents       Document[]
  fuelEntries     FuelEntry[]
  maintenance     MaintenanceRecord[]
  reminders       Reminder[]
  notifications   Notification[]
  emailTokens     EmailToken[]

  @@map("users")
}

/// Opaque refresh tokens, hashed at rest and rotated on every use.
///
/// `familyId` groups every token descended from one login. If a token that has
/// already been rotated is presented again, that is a replay: the entire family
/// is revoked rather than just the single token. See docs/decisions.md ADR-005.
model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the opaque token. The plaintext never touches the database, so
  /// a database leak alone cannot be replayed against the API.
  tokenHash String   @unique @db.Char(64)
  familyId  String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)

  /// Set when the token is rotated, revoked on logout, or revoked by replay
  /// detection. A token is usable only while this is null and expiresAt is future.
  revokedAt DateTime? @db.Timestamptz(3)

  userAgent String? @db.VarChar(512)
  ipAddress String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Phase 2b — federated identity
// ---------------------------------------------------------------------------

/// Identity providers the API can authenticate against. Stored rather than
/// inferred so an account records which provider vouched for it.
enum OAuthProvider {
  GOOGLE
  APPLE
}

/// A provider identity linked to a local user.
///
/// Separate from `User` because one person legitimately has several: a Google
/// account and, later, an Apple one, both reaching the same vehicles. Folding
/// the provider id onto `User` would allow exactly one, and adding the second
/// would then be a migration rather than an insert.
model OAuthAccount {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider OAuthProvider

  /// The provider's stable subject identifier — Google's `sub`. Deliberately
  /// not the email: people change their email address at the provider, and a
  /// reused address must never resolve to someone else's account.
  providerAccountId String @db.VarChar(255)

  /// The address the provider last reported, kept for display and support.
  /// Never used to resolve a login — `providerAccountId` is the identity.
  email String? @db.VarChar(320)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One local account per provider identity. The database refuses a second
  /// link rather than trusting every call site to check first.
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ---------------------------------------------------------------------------
// Phase 3 — vehicles, membership and the mileage timeline
// ---------------------------------------------------------------------------

/// Per-vehicle permission. Distinct from `UserRole`, which is platform-wide.
///
/// V1 only ever creates `OWNER` rows. `EDITOR` and `VIEWER` exist now so that
/// sharing later is an insert plus an invite endpoint, rather than a migration
/// that rewrites every access check. See docs/decisions.md ADR-006.
enum VehicleRole {
  OWNER
  EDITOR
  VIEWER
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
  CVT
}

/// Where a mileage reading came from. Phase 3 only writes `MANUAL`; the rest
/// arrive as fuel, expense, maintenance and trip records start carrying
/// odometer values.
enum OdometerSource {
  MANUAL
  FUEL
  EXPENSE
  MAINTENANCE
  TRIP
}

model Vehicle {
  id      String @id @default(uuid(7)) @db.Uuid
  /// Kept alongside `VehicleMember` rather than replaced by it: the owner is a
  /// property of the vehicle (who bought it), while membership is a property of
  /// access. Authorisation never reads this column — see ADR-006.
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  make         String  @db.VarChar(64)
  model        String  @db.VarChar(64)
  year         Int     @db.SmallInt
  licensePlate String  @db.VarChar(32)
  /// 17 characters by ISO 3779. Optional: plenty of owners never record it.
  vin          String? @db.VarChar(17)

  fuelType     FuelType
  /// Displacement in litres, e.g. 1.6. Meaningless for an EV, hence optional.
  engineSize   Decimal?      @db.Decimal(3, 1)
  transmission Transmission?

  /// Denormalised from `OdometerReading`, because the dashboard reads it on
  /// every page load and a MAX() subquery per vehicle is wasteful. Written only
  /// by OdometerService, inside the same transaction as the reading itself.
  currentOdometerKm Int @default(0)

  purchaseDate  DateTime? @db.Timestamptz(3)
  /// Excluded from cost-per-kilometre by default and reported separately —
  /// including a 40,000 TND purchase makes the first month meaningless (ADR-012).
  purchasePrice Decimal?  @db.Decimal(12, 3)

  color String? @db.VarChar(32)
  notes String? @db.Text

  /// Set when a vehicle is sold or retired. Archiving keeps its cost history
  /// intact and out of the default list; deleting discards the history, which
  /// is a different and much rarer intent.
  archivedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members          VehicleMember[]
  odometerReadings OdometerReading[]
  expenses         Expense[]
  documents        Document[]
  fuelEntries      FuelEntry[]
  maintenance      MaintenanceRecord[]
  schedules        MaintenanceSchedule[]
  reminders        Reminder[]
  notifications    Notification[]

  @@unique([ownerId, licensePlate])
  @@index([ownerId])
  @@index([ownerId, archivedAt])
  @@map("vehicles")
}

/// The single authority on who may reach a vehicle.
///
/// Every vehicle-scoped request resolves through here before it reads anything,
/// so no endpoint ever trusts an id from the client. See ADR-006.
model VehicleMember {
  id        String  @id @default(uuid(7)) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  role VehicleRole @default(VIEWER)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// One membership per person per vehicle; the database refuses a duplicate
  /// rather than trusting every call site to check first.
  @@unique([vehicleId, userId])
  @@index([userId])
  @@map("vehicle_members")
}

/// The mileage timeline.
///
/// Its own table because mileage arrives from five places, and because "how far
/// did this car travel between two dates" — the denominator of cost per
/// kilometre — must be one indexed range scan rather than a scan of every cost
/// record. See docs/database.md §3.2.
model OdometerReading {
  id        String  @id @default(uuid(7)) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  recordedAt DateTime @db.Timestamptz(3)
  odometerKm Int

  source   OdometerSource @default(MANUAL)
  /// The fuel entry, expense or maintenance record that produced this reading.
  /// Not a foreign key: it points into whichever table `source` names.
  sourceId String?        @db.Uuid

  notes String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// `(vehicleId, recordedAt)` serves the mileage chart and date-range
  /// distance; `(vehicleId, odometerKm)` serves "the reading before this one",
  /// which the full-to-full consumption engine needs in Phase 5.
  @@index([vehicleId, recordedAt])
  @@index([vehicleId, odometerKm])
  @@map("odometer_readings")
}

// ---------------------------------------------------------------------------
// Phase 4 — the cost ledger
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  REPAIR
  INSURANCE
  TAX
  PARKING
  TOLL
  CLEANING
  ACCESSORIES
  TIRES
  INSPECTION
  OTHER
}

/// Which feature wrote the row. Phase 4 only writes `MANUAL`; fuel entries and
/// maintenance records arrive in Phases 5 and 6 and own a 1:1 expense each.
enum ExpenseSource {
  MANUAL
  FUEL
  MAINTENANCE
}

/// Every cost the vehicle incurs, whichever feature recorded it.
///
/// One table rather than one per feature, so "what has this car cost me" is a
/// single indexed aggregate instead of a four-way UNION. See ADR-004.
///
/// There is deliberately no `currency` column: amounts are in the owner's
/// display currency until per-record currency is a product decision rather
/// than a schema detail (ADR-016).
model Expense {
  id        String  @id @default(uuid(7)) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Attribution, not ownership — the expense belongs to the vehicle. Nullable
  /// so that a shared editor deleting their account does not take part of
  /// someone else's cost history with them.
  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  category ExpenseCategory
  /// Always positive; the migration adds a CHECK so the database refuses a
  /// zero or a refund-by-sign rather than trusting every writer to validate.
  amount   Decimal         @db.Decimal(12, 3)

  incurredAt DateTime @db.Timestamptz(3)
  /// When present, the same transaction writes an `OdometerReading` with
  /// `source = EXPENSE` and `sourceId` pointing back here.
  odometerKm Int?

  description String? @db.VarChar(200)
  vendor      String? @db.VarChar(120)
  notes       String? @db.Text

  /// A fuel- or maintenance-derived row is edited through its owning record,
  /// never directly, or its amount and its source would disagree.
  sourceType ExpenseSource @default(MANUAL)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  documents         Document[]
  /// Set when a fuel entry owns this row (`sourceType = FUEL`).
  fuelEntry         FuelEntry?
  /// Set when a maintenance record owns this row (`sourceType = MAINTENANCE`).
  maintenanceRecord MaintenanceRecord?

  /// `(vehicleId, incurredAt DESC)` serves the paginated ledger;
  /// `(vehicleId, category, incurredAt)` serves spend by category for a period.
  @@index([vehicleId, incurredAt(sort: Desc)])
  @@index([vehicleId, category, incurredAt])
  @@map("expenses")
}

/// A client-supplied `Idempotency-Key`, remembered against what it created.
///
/// A double-tapped submit on a slow connection must not file the same cost
/// twice. The key is inserted in the same transaction as the resource, so two
/// concurrent requests carrying it cannot both succeed: the unique index lets
/// exactly one commit, and the other replays the winner. See api.md §8.
model IdempotencyKey {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key         String   @db.VarChar(255)
  /// The operation the key was spent on, e.g. `expense.create`.
  scope       String   @db.VarChar(64)
  /// SHA-256 of the scope, target and body. A reused key with a different
  /// request is a client bug, and is refused rather than silently replayed.
  requestHash String   @db.Char(64)
  /// Not a foreign key: it points into whichever table `scope` writes.
  resourceId  String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  /// Scoped per user, so one person's key can never collide with another's.
  @@unique([userId, key])
  /// For the purge job that expires old keys (Phase 7).
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Phase 4b — receipts and invoices, the first slice of Phase 8's documents
// ---------------------------------------------------------------------------

enum DocumentType {
  INSURANCE
  REGISTRATION
  INSPECTION
  INVOICE
  RECEIPT
  PURCHASE
  OTHER
}

/// The bytes go straight to object storage through a presigned URL, so the row
/// exists before they do: `PENDING_UPLOAD` until the client confirms and the
/// API has checked the stored object, then `READY`. See ADR-009.
enum DocumentStatus {
  PENDING_UPLOAD
  READY
  FAILED
}

/// A file kept against a vehicle — for now, a receipt or invoice on an expense.
///
/// Only metadata lives here. `storageKey` is generated by the API and never
/// derived from `fileName`, which is the uploader's and is used for display
/// and for the download's Content-Disposition only.
///
/// `maintenanceRecordId` from docs/database.md arrives with Phase 6, when the
/// table it points at exists.
model Document {
  id        String  @id @default(uuid(7)) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Attribution, nullable for the same reason as `Expense.createdById`.
  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  type      DocumentType
  title     String       @db.VarChar(200)
  fileName  String       @db.VarChar(255)
  mimeType  String       @db.VarChar(100)
  /// Declared at request time and signed into the upload URL; checked against
  /// the stored object before the row becomes READY.
  sizeBytes Int

  storageKey String         @unique @db.VarChar(255)
  checksum   String?        @db.VarChar(128)
  status     DocumentStatus @default(PENDING_UPLOAD)

  issuedAt  DateTime? @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)

  /// A receipt belongs to its expense and goes with it. The object in storage
  /// cannot cascade from here, so the expense service deletes it after commit.
  expenseId String?  @db.Uuid
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, type])
  @@index([vehicleId, expiresAt])
  /// An expense's attachments, listed with the ledger.
  @@index([expenseId])
  /// For the job that sweeps uploads never confirmed (Phase 7).
  @@index([status, createdAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Phase 5 — fuel
// ---------------------------------------------------------------------------

/// One visit to the pump.
///
/// Owns a 1:1 `Expense` (category FUEL, source FUEL) holding its cost, and an
/// `OdometerReading` (source FUEL) holding its mileage — all three written in
/// one transaction, so the ledger, the timeline and the fuel log cannot
/// disagree. See ADR-004 and ADR-018.
model FuelEntry {
  id        String  @id @default(uuid(7)) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Attribution, nullable for the same reason as `Expense.createdById`.
  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /// The ledger row. Deleting the entry deletes it through the service, and
  /// the cascade covers the vehicle being deleted underneath both.
  expenseId String  @unique @db.Uuid
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  filledAt   DateTime @db.Timestamptz(3)
  odometerKm Int

  /// Litres to the centilitre — what a pump display shows.
  volumeLiters  Decimal @db.Decimal(7, 2)
  /// Millimes per litre, as the pump shows it.
  pricePerLiter Decimal @db.Decimal(8, 3)
  /// What was paid. Mirrored into `Expense.amount`; this is the source.
  totalCost     Decimal @db.Decimal(12, 3)

  fuelType FuelType

  /// Filled to the brim. Only two full fills bound a consumption window.
  isFullTank   Boolean @default(true)
  /// A fill *before* this one was never logged, so the window ending here
  /// is missing litres and must not produce a consumption figure.
  isMissedFill Boolean @default(false)

  stationName String?  @db.VarChar(120)
  /// Where the fill happened, when the browser shared it. Used only to
  /// suggest this station the next time someone fills up nearby.
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  notes String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// `(vehicleId, odometerKm)` orders the history for the consumption engine;
  /// `(vehicleId, filledAt DESC)` serves the paginated log.
  @@index([vehicleId, odometerKm])
  @@index([vehicleId, filledAt(sort: Desc)])
  @@map("fuel_entries")
}

// ---------------------------------------------------------------------------
// Phase 6 — maintenance
// ---------------------------------------------------------------------------

enum MaintenanceType {
  OIL_CHANGE
  OIL_FILTER
  AIR_FILTER
  CABIN_FILTER
  BRAKE_PADS
  BRAKE_DISCS
  TIRES
  BATTERY
  COOLANT
  TRANSMISSION
  TIMING_BELT
  INSPECTION
  OTHER
}

/// A service that was carried out.
///
/// Owns its ledger expense like a fuel entry does (ADR-004), with one
/// difference: a service can be free — a warranty service, a dealer's first
/// inspection — and still reset its schedule. The ledger refuses a zero
/// amount, so a free record simply has no expense (ADR-019).
model MaintenanceRecord {
  id        String  @id @default(uuid(7)) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Attribution, nullable for the same reason as `Expense.createdById`.
  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /// The ledger row, absent exactly when `totalCost` is zero. The cascade
  /// covers the vehicle being deleted underneath both.
  expenseId String?  @unique @db.Uuid
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  /// The schedule this service satisfies. Deleting the schedule keeps the
  /// record — it still happened, and still cost what it cost.
  scheduleId String?              @db.Uuid
  schedule   MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  type        MaintenanceType
  performedAt DateTime        @db.Timestamptz(3)
  /// Also a `MAINTENANCE` reading on the odometer timeline.
  odometerKm  Int

  /// Either split may be unknown — an invoice often shows only a total. When
  /// both are known they add up to the total exactly; the service enforces it.
  partsCost Decimal? @db.Decimal(12, 3)
  laborCost Decimal? @db.Decimal(12, 3)
  /// What was paid. Mirrored into `Expense.amount`; this is the source.
  totalCost Decimal  @db.Decimal(12, 3)

  serviceProvider String? @db.VarChar(120)
  description     String? @db.VarChar(200)
  notes           String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// `(vehicleId, performedAt DESC)` serves the paginated log;
  /// `(vehicleId, type, performedAt DESC)` the log filtered by type.
  /// `(scheduleId, performedAt)` finds a schedule's last service.
  @@index([vehicleId, performedAt(sort: Desc)])
  @@index([vehicleId, type, performedAt(sort: Desc)])
  @@index([scheduleId, performedAt])
  @@map("maintenance_records")
}

/// A recurring service: "oil change every 10,000 km or 12 months".
///
/// Whether it is due is never stored — it depends on today's date and the
/// vehicle's current mileage, so a stored copy would be stale the moment
/// either moved. The due engine derives it on every read.
model MaintenanceSchedule {
  id        String  @id @default(uuid(7)) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type MaintenanceType
  name String          @db.VarChar(120)

  /// At least one is set; the migration adds the CHECK. Whichever comes
  /// first makes the service due.
  intervalKm     Int?
  intervalMonths Int? @db.SmallInt

  /// The last service *before CarCare knew about it* — what the owner
  /// remembers when setting the schedule up. Records linked to the schedule
  /// supersede it as they are logged, and deleting one falls back to it,
  /// so it is never overwritten by a record (ADR-019).
  lastServiceOdometerKm Int?
  lastServiceAt         DateTime? @db.Timestamptz(3)

  /// How early "due soon" starts, and how long past due "due" lasts before
  /// it becomes "overdue".
  notifyBeforeKm   Int @default(1000)
  notifyBeforeDays Int @default(30) @db.SmallInt

  /// A paused schedule keeps its history and still reports its status, but is
  /// listed last and will never raise a reminder (Phase 7).
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  records MaintenanceRecord[]

  @@index([vehicleId, isActive])
  @@map("maintenance_schedules")
}

// ---------------------------------------------------------------------------
// Phase 7 — reminders and notifications
// ---------------------------------------------------------------------------

enum ReminderType {
  INSURANCE
  ROAD_TAX
  LOAN
  WARRANTY
  OTHER
}

enum ReminderStatus {
  PENDING
  COMPLETED
}

/// Something that falls due once, on a date or at a mileage: an insurance
/// renewal, the annual road tax, the end of a warranty. Recurring *services*
/// are maintenance schedules; this is for everything else.
///
/// Like a schedule, how close it is is derived on read, never stored. A
/// reminder that repeats is completed and succeeded by a new row, so the one
/// that was paid keeps its completion date.
model Reminder {
  id        String  @id @default(uuid(7)) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Attribution, nullable for the same reason as `Expense.createdById`.
  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  type        ReminderType
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(500)

  /// At least one is set; the migration adds the CHECK. Whichever comes
  /// first makes it due. A calendar date, not an instant: "the insurance
  /// renews on 1 March" means the owner's 1 March.
  dueDate       DateTime? @db.Date
  dueOdometerKm Int?

  notifyBeforeDays Int @default(30) @db.SmallInt
  notifyBeforeKm   Int @default(1000)

  /// Completing a repeating reminder creates the next one this many months
  /// after the due date. Needs a due date to count from.
  repeatEveryMonths Int? @db.SmallInt

  status      ReminderStatus @default(PENDING)
  completedAt DateTime?      @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// `(vehicleId, dueDate)` lists a vehicle's reminders. The sweep's partial
  /// index on pending rows is hand-written in the migration.
  @@index([vehicleId, dueDate])
  @@map("reminders")
}

enum NotificationType {
  MAINTENANCE_DUE
  REMINDER_DUE
}

/// Whether a notification still owes an email. `SKIPPED` when the user has
/// email turned off, or the server has no mail transport, when it is created.
enum NotificationEmailStatus {
  PENDING
  SENT
  SKIPPED
}

/// One message in a user's inbox.
///
/// `dedupeKey` is the idempotency mechanism: the sweep runs every hour and
/// would otherwise say "oil change due soon" every hour. The unique
/// constraint turns a repeated insert into a no-op, so job retries and
/// overlapping workers are safe by construction rather than by timing.
model Notification {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A notification about a car goes with the car.
  vehicleId String?  @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String           @db.VarChar(200)
  body  String           @db.Text
  /// What the notification is about, for linking: ids and the status reached.
  data  Json             @default("{}")

  dedupeKey String @db.VarChar(200)

  readAt      DateTime?               @db.Timestamptz(3)
  emailStatus NotificationEmailStatus @default(PENDING)
  emailedAt   DateTime?               @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// The unread and unsent partial indexes are hand-written in the migration.
  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// A single-use link sent by email: "confirm your address", "reset your password".
///
/// Stored as a SHA-256 hash, like refresh tokens, so a database leak yields no
/// working links. `email` is the address it was sent to: if the account's
/// address has changed since, the link no longer proves anything and is refused.
model EmailToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   EmailTokenPurpose
  tokenHash String            @unique @db.Char(64)
  email     String            @db.VarChar(320)

  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("email_tokens")
}
