# ---------------------------------------------------------------------------
# CarCare — local environment template
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.
# Variables consumed by the API are validated at boot (backend/src/config/
# env.schema.ts); an invalid value stops the process with a readable message.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# api | worker | all. One image, two roles; `all` is a local convenience.
APP_ROLE=all

# --- API ---------------------------------------------------------------------
BACKEND_PORT=3001
API_PREFIX=api
# Comma-separated. Must include the frontend origin or the browser blocks calls.
CORS_ORIGINS=http://localhost:3000
# Turn on behind a reverse proxy so X-Forwarded-For is trusted for rate limiting.
# false, true (one hop) or a number of proxy hops. Online behind Vercel + Render: 2.
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

# --- Logging -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable colour output. Development only — it is slow.
LOG_PRETTY=true

# --- API documentation -------------------------------------------------------
# Force-disabled when NODE_ENV=production regardless of this value.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Authentication ----------------------------------------------------------
# Signing key for access tokens. No default and no fallback: the API refuses to
# boot without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates every issued access token (users simply refresh);
# refresh tokens are unaffected, because they are not signed.
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters-abcdefgh
# Duration string. Short by design — revocation is the refresh token's job.
JWT_ACCESS_TTL=15m
JWT_ISSUER=carcare
JWT_AUDIENCE=carcare-api

# How long "stay signed in" lasts before a full re-login.
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=carcare_refresh_token
# Leave unset for a host-only cookie. Set it only when the web app and the API
# sit on different subdomains of one site (e.g. .carcare.app).
# REFRESH_COOKIE_DOMAIN=
# Defaults to on when NODE_ENV=production. Keep it off for plain-HTTP localhost,
# or the browser will silently refuse to store the cookie.
REFRESH_COOKIE_SECURE=false
# Grace period in which two tabs refreshing at once counts as one refresh
# rather than as a stolen-token replay. See docs/decisions.md ADR-010.
REFRESH_REUSE_GRACE_MS=10000

# Redis-backed sliding window on the auth endpoints. Never off in production.
AUTH_RATE_LIMIT_ENABLED=true

# --- Sign in with Google -----------------------------------------------------
# Optional. Leave both unset and the API runs password-only: /auth/providers
# returns [], and the web app renders no provider buttons.
#
# Create credentials at https://console.cloud.google.com/apis/credentials
#   > Create OAuth client ID > Web application
# Authorised redirect URI must match EXACTLY:
#   http://localhost:3001/api/v1/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public origins as a browser sees them. OAuth redirects are absolute, so these
# cannot be inferred from the request — a Host header is attacker-controlled.
API_PUBLIC_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=carcare
POSTGRES_PASSWORD=carcare
POSTGRES_DB=carcare
POSTGRES_PORT=5432
# Host value. Inside Docker Compose the host is `db`, not `localhost`.
DATABASE_URL=postgresql://carcare:carcare@localhost:5432/carcare?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally; receipts and invoices) --------------------
MINIO_ROOT_USER=carcare
MINIO_ROOT_PASSWORD=carcare-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=carcare-documents
# How the API reaches the store when run outside Docker. Leave the credentials
# unset to run without storage: the API still boots, and attaching a receipt
# answers 503. Inside Compose these are set for you.
S3_ENDPOINT=http://localhost:9000
# Where the *browser* reaches it; presigned URLs are signed for this host.
# Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=carcare
S3_SECRET_ACCESS_KEY=carcare-dev-secret
# MinIO serves buckets by path rather than by subdomain.
S3_FORCE_PATH_STYLE=true
#
# Browsers upload straight to the bucket, so it must allow the web app's origin.
# Compose sets this for MinIO. An externally managed bucket (AWS S3, R2…) needs
# a CORS rule of its own — see docs/decisions.md ADR-009.

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=3000
# Origin only. The client appends /api/v1; health probes sit outside it.
# Inlined at build time — changing it requires rebuilding the frontend image.
# Online, `same-origin`: the website forwards /api to the API (API_PROXY_TARGET).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=CarCare

# --- Email (Phase 7: reminder digests) ----------------------------------------
# Unset SMTP_HOST and reminders stay in the in-app inbox only. Locally, run
# `docker compose up -d mailpit` and read what was sent at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=CarCare <reminders@carcare.local>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
